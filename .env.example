# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=upd
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=upd
# Постоянное имя Docker volume, не зависящее от имени папки проекта.
POSTGRES_VOLUME_NAME=release1c_pgdata

# Docker-образ. Для реестра укажите, например, ghcr.io/owner/release1c:latest.
APP_IMAGE=release1c:latest
# Локально образ собирается из исходников. Для опубликованного образа задайте always.
APP_PULL_POLICY=never

# Собирается автоматически из переменных выше для docker-compose.
# Для локального запуска (tsx напрямую) — указать явно:
DATABASE_URL=postgres://upd:change-this-password@localhost:5432/upd

# ── Учётные записи ИТС ────────────────────────────────────────────────────────
ITS_LOGIN=
ITS_PASSWORD=

# Ключ шифрования паролей нескольких ИТС-аккаунтов в PostgreSQL.
# Создать: openssl rand -base64 32
# После сохранения аккаунтов ключ менять нельзя без повторного ввода паролей.
ITS_CREDENTIALS_KEY=

# ── Импорт ───────────────────────────────────────────────────────────────────
# Cron-расписание (по умолчанию каждый день в 04:00).
IMPORT_CRON=0 4 * * *

# Запустить импорт сразу при старте воркера (1 = да). Безопасный первый запуск — 0.
IMPORT_ON_START=0

# Как часто worker проверяет очередь ошибочных страниц релизов (минуты).
RETRY_QUEUE_POLL_MINUTES=5

# Фоновая обработка ещё не загруженных исторических страниц релизов (минуты).
ARCHIVE_BACKFILL_POLL_MINUTES=60

# Максимальный размер загружаемой копии каталога в байтах (по умолчанию 20 ГиБ).
DATABASE_BACKUP_MAX_BYTES=21474836480

# ── Веб ──────────────────────────────────────────────────────────────────────
# Внешние HTTP/HTTPS-порты Caddy.
WEB_PORT=
HTTPS_PORT=443

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
# CADDY_API — внутренний адрес Caddy Admin API (менять не нужно).
CADDY_API=http://caddy:2019

# ── Администраторская панель (/admin) ─────────────────────────────────────────
# Эти данные не связаны с ИТС. Задайте их перед первым запуском приложения.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-password
