# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=upd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=upd

# Собирается автоматически из переменных выше для docker-compose.
# Для локального запуска (tsx напрямую) — указать явно:
DATABASE_URL=postgres://upd:changeme@localhost:5432/upd

# ── Источник .lst ─────────────────────────────────────────────────────────────
# Вариант 1: ITS (production)
ITS_LOGIN=
ITS_PASSWORD=

# Вариант 2: локальный файл (dev-replay, без ITS)
# Положи v8cscdsc.lst в ./data/ и раскомментируй:
# LST_FILE=/data/v8cscdsc.lst

# ── Импорт ───────────────────────────────────────────────────────────────────
# Cron-расписание (default: каждый день в 04:00)
IMPORT_CRON=0 4 * * *

# Запустить импорт сразу при старте воркера (1 = да)
IMPORT_ON_START=1

# ── Веб ──────────────────────────────────────────────────────────────────────
# WEB_PORT — прямой порт для доступа без Caddy (например, в dev).
# При использовании Caddy (HTTPS) оставьте пустым — трафик идёт через :80/:443.
WEB_PORT=

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
# DOMAIN задаётся через /admin → "Домен и HTTPS" — здесь для справки.
# CADDY_API — внутренний адрес Caddy Admin API (менять не нужно).
DOMAIN=
CADDY_API=http://caddy:2019

# ── Режим «за внешним прокси» (deploy.sh, вариант 2) ─────────────────────────
# Nginx Proxy Manager / nginx / Traefik уже держит 80 и 443: своего Caddy нет,
# HTTPS делает прокси. deploy.sh дописывает:
#   CADDY_API=off
#   COMPOSE_FILE=docker-compose.proxy.yml   (docker compose берёт этот файл сам)
#   PROXY_NETWORK=<Docker-сеть прокси>     (веб в ней как updatecon:3000)
#   WEB_PORT=3000                          (для прокси на хосте: 127.0.0.1:3000)

# ── Автообновление (deploy.sh) ───────────────────────────────────────────────
# 1 — установлен /etc/cron.d/updatecon: каждую ночь в 3:30 update.sh. Для админки.
# AUTO_UPDATE=1

# ── Снимок базы с GitHub ─────────────────────────────────────────────────────
# Без учётки ИТС воркер берёт готовую базу из релиза «data» репозитория.
# off — не брать; другой адрес — свой источник снимков.
# SNAPSHOT_URL=https://github.com/iMironRU/updatecon/releases/download/data/

# ── Администраторская панель (/admin) ─────────────────────────────────────────
# Эти кредиты НЕ связаны с ИТС. Задаются при установке через deploy.sh.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme
