{
  "name": "release1c",
  "version": "1.0.0",
  "description": "Каталог релизов 1С и калькулятор цепочек обновления по данным LST и releases.1c.ru",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm run check:themes",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "import:lst": "tsx src/db/import-lst.ts",
    "import:releases": "tsx src/releases/import-releases.ts",
    "backfill:changes": "tsx src/releases/backfill-change-feed.ts",
    "server": "tsx src/db/server.ts",
    "worker": "tsx src/db/worker.ts",
    "dev": "tsx watch src/db/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:themes": "node scripts/check-themes.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "^12.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@fastify/static": "$@fastify/static",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
